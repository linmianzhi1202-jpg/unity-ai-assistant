  "extension_notes": {
    "how_to_add_new_tool": [
      "1. Implement and register the Unity handler/action before exposing a tool",
      "2. Add the MCP tool name and handler/action mapping under mappings",
      "3. Keep parameter conversion in the Python tool and call ToolRouter.send_tool(mcp_tool_name, extra_args)",
      "4. Assign exactly one group:* tag; do not maintain a separate group map",
      "5. Run startup_validator and the interface compatibility tests"
    ],
    "special_routing": {
      "manage_editor": "Single handler for many actions (play/stop/pause/refresh/check_compile_errors/get_unity_logs/get_editor_state/execute_menu_item/get_registered_actions/capture_screenshot)",
      "manage_scene": "Scene operations (save/open/create/get_hierarchy/get_active)",
      "manage_gameobject": "GameObject lifecycle (create/delete/duplicate/rename/parent/set_sibling_index)",
      "Tier 2 execute_script": "Always use send_to_unity('manage_editor', {action: 'check_compile_errors'/'execute_menu_item'/'get_unity_logs'}) for compile+execute+log pipeline"
    }
