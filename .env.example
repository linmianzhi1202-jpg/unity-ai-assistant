# ──────────────────────────────────────────────────────────
# Unity AI 开发助手 — 环境变量配置模板
# 用法：复制本文件为 .env 并按需填写。
# .env 已被 .gitignore 忽略，不会提交到版本库。
# ──────────────────────────────────────────────────────────

# ── 核心（建议保持默认）────────────────────────────────
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
UNITY_MCP_TRANSPORT=stdio

# ── 可选：图谱检索（需要本地 Ollama）────────────────────
# 未安装 Ollama 时，图谱检索（knowledge_graph_search 等）不可用；
# 向量检索（knowledge_search）不受影响。
OLLAMA_HOST=http://localhost:11434
UNITY_MCP_RAG_MODEL=gemma3:4b
UNITY_MCP_RAG_TIMEOUT=60

# ── 可选：Unity 连接（存在多个 Unity 项目时建议设置项目路径）──
# UNITY_MCP_UNITY_HOST=127.0.0.1
# UNITY_MCP_UNITY_PORT=6400
# UNITY_MCP_PROJECT_PATH=

# ── 可选：工具组过滤（默认启用全部，多个组用逗号分隔）────
UNITY_MCP_ENABLED_GROUPS=all

# ── 可选：AI 资产生成（需要第三方服务密钥，用不到可不填）──
# MESHY_API_KEY=          # 文生 3D 模型（generate_3d_model）
# OPENAI_API_KEY=         # 文生图（generate_image）
# ELEVENLABS_API_KEY=     # 音效生成（generate_sfx）
