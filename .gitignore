# ── Python ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/

# ── MCP 本地生成配置（由 install.bat 根据 mcp.json.template 生成）──
mcp.json

# ── 本地环境变量（可能包含 API Key 等敏感信息）─────────────
.env

# ── 本地数据（知识库走 GitHub Release 分发，不进 Git）──
Server/data/base_kb/
Server/data/game-rag-knowledge-base/data/
Server/data/game-rag-knowledge-base/logs/
Server/data/asset_library/

# ── Python 打包产物 ─────────────────────────────────────
*.egg-info/

# ── PowerShell 误生成的缓存 ─────────────────────────────
Microsoft/

# ── CodeBuddy 本地会话计划产物 ─────────────────────────
.codebuddy/plans/
